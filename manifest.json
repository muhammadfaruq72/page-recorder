{
  "manifest_version": 3,
  "name": "Page Viewport",
  "version": "2.2.1",
  "description": "Toggle left-aligned desktop or mobile viewports in fullscreen. Collect scroll points and move smoothly with keyboard shortcuts.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "debugger"
  ],
  "commands": {
    "scroll-down": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "Scroll down by the saved viewport percentage in viewport mode"
    },
    "scroll-up": {
      "suggested_key": {
        "default": "Ctrl+Shift+8",
        "mac": "Command+Shift+8"
      },
      "description": "Scroll down one full viewport height in viewport mode"
    },
    "scroll-next-point": {
      "suggested_key": {
        "default": "Ctrl+Shift+7",
        "mac": "Command+Shift+7"
      },
      "description": "Scroll to the next saved page position in viewport mode"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Page Viewport \u2014 open controls",
    "default_icon": {
      "16": "icons/record-16.png",
      "32": "icons/record-32.png",
      "48": "icons/record-48.png",
      "128": "icons/record-128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/record-16.png",
    "32": "icons/record-32.png",
    "48": "icons/record-48.png",
    "128": "icons/record-128.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
